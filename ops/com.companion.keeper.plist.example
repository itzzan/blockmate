<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MacBook 上 keeper 的 launchd 配置（手册 7.2）。拷到 ~/Library/LaunchAgents/com.companion.keeper.plist，路径把 __USER__ 换成你的用户名，路径按实际改成绝对路径（Java 21 的位置用 /usr/libexec/java_home -v 21 查）。 -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.companion.keeper</string>
  <key>ProgramArguments</key><array>
    <string>/Users/__USER__/Library/Java/JavaVirtualMachines/ms-21.0.9/Contents/Home/bin/java</string>
    <string>-jar</string><string>/Users/__USER__/Code/My/AI/blockmate/keeper.jar</string>
    <string>--config</string><string>/Users/__USER__/Code/My/AI/blockmate/keeper.yaml</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>/Users/__USER__/Code/My/AI/blockmate/logs/keeper.log</string>
  <key>StandardErrorPath</key><string>/Users/__USER__/Code/My/AI/blockmate/logs/keeper.err</string>
</dict></plist>
