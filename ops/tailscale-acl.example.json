// 手册 1.2 的 Tailscale 访问规则模板。复制为 tailscale-acl.local.json（已 gitignore）填好邮箱后，贴到 https://login.tailscale.com/admin/acls。
// 把三处 you@example.com 换成你登录 Tailscale 的邮箱（Tailscale 的策略文件允许这种 // 注释）。
// 注意：贴上去会替换掉现有的全部规则；tailnet 里其他成员之后只能连服务器的 25565。
{
  "tagOwners": {
    "tag:mcserver":    ["you@example.com"],
    "tag:workstation": ["you@example.com"]
  },
  "grants": [
    // 1. 所有成员（Windows、将来的朋友）和 MacBook 都能连服务器的 25565：玩游戏
    {"src": ["autogroup:member", "tag:workstation"], "dst": ["tag:mcserver"], "ip": ["tcp:25565"]},
    // 2. 只有你本人能连 Mac mini 的 SSH / 聊天网页 / 后台 / RCON / 屏幕共享
    {"src": ["you@example.com"], "dst": ["tag:mcserver"],    "ip": ["tcp:22", "tcp:443", "tcp:8787", "tcp:25575", "tcp:5900"]},
    // 3. 只有你本人能远程操作 MacBook
    {"src": ["you@example.com"], "dst": ["tag:workstation"], "ip": ["tcp:22", "tcp:5900"]},
    // 4. MacBook 能连 Mac mini 的 SSH（22）、聊天网页（443）和后台（8787）；MacBook 贴了标签后不再算"本人"，所以 22/443 要在这里放行
    {"src": ["tag:workstation"], "dst": ["tag:mcserver"],    "ip": ["tcp:22", "tcp:443", "tcp:8787"]},
    // 5. Mac mini（后台）能连 MacBook 的 11434：调大模型
    {"src": ["tag:mcserver"],    "dst": ["tag:workstation"], "ip": ["tcp:11434"]}
  ]
}
